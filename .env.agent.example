# ClickUp queue. Keep the real token outside Git and load it only in the
# orchestrator process.
CLICKUP_API_TOKEN=
CLICKUP_LIST_ID=
CLICKUP_QUEUE_STATUS="to do"
CLICKUP_WORKING_STATUS="in progress"
CLICKUP_REVIEW_STATUS=review
CLICKUP_BLOCKED_STATUS=blocked

# Repository and verification.
AGENT_BASE_BRANCH=main
AGENT_TEST_COMMAND="PYTHONDONTWRITEBYTECODE=1 python3 -m unittest discover -s tests -p 'test_*.py'"
AGENT_EXECUTOR_MODEL=
AGENT_REVIEWER_MODEL=
AGENT_CODEX_TIMEOUT_SECONDS=3600
AGENT_TEST_TIMEOUT_SECONDS=900

# The pipeline creates a branch and PR after tests and reviewer approval.
# It never merges the PR.
AGENT_PUSH_APPROVED_BRANCH=true
AGENT_KEEP_SUCCESS_WORKTREE=false

# Set this only on a dedicated disposable runner that has no personal or
# application credential stores. Live runs fail closed without this attestation.
AGENT_ISOLATED_RUNNER=false
