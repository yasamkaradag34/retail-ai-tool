# ─────────────────────────────────────────────────────────────
# DataProvido - Production Environment Variables
# Add these variables to your Railway / Server Dashboard
# ─────────────────────────────────────────────────────────────

# Google OAuth 2.0 Credentials (from Google Cloud Console)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-client-secret
GOOGLE_REDIRECT_URI=https://www.dataprovido.com/api/auth/google/callback

# Stable random cookie signing secret (generate privately, never commit its value).
# Local fallback is random per process; set this before using multiple workers.
COOKIE_SECRET=

# Paid Google-account access. API key must be able to read customers/subscriptions.
STRIPE_SECRET_KEY=
STRIPE_STANDARD_PRICE_ID=
STRIPE_PRO_PRICE_ID=
# Existing Payment Links require the corresponding Price IDs above.
# App-created Checkout subscriptions also carry DataProvido metadata.
BASE_URL=https://www.dataprovido.com

# Email/password sign-in and password recovery (Supabase Auth).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=

# LLM Backend Config
LLM_BACKEND=groq
GROQ_API_KEY=gsk_your_groq_api_key
